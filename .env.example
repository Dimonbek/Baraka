# ─── Ma'lumotlar bazasi ───
# Dev: lokal Docker Postgres  |  Prod: Neon "Pooled connection"
DATABASE_URL="postgresql://uvol:uvol@localhost:5433/uvol"

# ─── Telegram ───
TELEGRAM_BOT_TOKEN=
# Webhook maxfiy so'zi (tasodifiy satr)
TELEGRAM_WEBHOOK_SECRET=change-me

# ─── Ilova manzili ───
# Dev: ngrok URL  |  Prod: Vercel domeni (https://...)
NEXT_PUBLIC_APP_URL=

# ─── Fayl saqlash ───
# Prod'da Vercel Blob tokeni; bo'sh bo'lsa dev'da public/uploads ishlatiladi
BLOB_READ_WRITE_TOKEN=

# ─── Admin panel (/admin) ───
# Parol hash'ini yaratish:
#   node -e "console.log(require('bcryptjs').hashSync('SIZNING_PAROL',10))"
# MUHIM: .env ichida har $ belgisini \$ bilan ekranlang!
ADMIN_PASSWORD_HASH=
# Sessiya imzosi uchun tasodifiy 32-baytli kalit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
